{
  "name": "beep-cars",
  "version": "1.0.0",
  "private": true,
  "description": "叭叭車 Beep Cars — a camera-and-microphone car game for toddlers, played with big body movements.",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "start": "node scripts/serve.mjs",
    "test": "npm run test:unit && npm run test:e2e",
    "test:unit": "node --test test/unit/",
    "test:e2e": "playwright test",
    "proofs": "node scripts/build.mjs && node scripts/proofs.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "esbuild": "0.28.2"
  },
  "engines": {
    "node": ">=20"
  }
}
